# Public client keys only below the VITE_ line. Never put the service-role
# key or VAPID private key in frontend code.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push — generate a pair with: npm run vapid
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Server-only. Used by the Netlify/dev push function to read subscriptions
# and send alerts. Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If set, Supabase Database Webhooks must send the same header.
PUSH_WEBHOOK_SECRET=
